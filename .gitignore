# ============================================================
# MaapSetu .gitignore
# ============================================================

# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ---------- Build Outputs ----------
build/
dist/
out/
dist-client/
dist-server/
coverage/
.serverless/
.next/
.nuxt/

# ---------- Vercel-generated API handler (created at build time by scripts/prepare-vercel-api.js)
api/index.js
.vercel/

# ---------- Package Manager Locks ----------
# We track package-lock.json for reproducible builds with npm.
# If you switch package managers, swap the ignore rules below.
bun.lock
# package-lock.json   (TRACKED - do NOT ignore for npm projects)
yarn.lock
pnpm-lock.yaml

# ---------- Runtime Data & DB ----------
# JSON database and uploads are runtime-generated, do not commit
data/*.json
data/uploads/
data/**/*.pdf
# Keep data/ directory structure with README if needed:
!data/.gitkeep

# ---------- Environment & Secrets ----------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example

# ---------- OS & IDE ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.swn

# ---------- Logs & Debug ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ---------- Vite / Dev Caches ----------
.vite/
.turbo/
.cache/
.parcel-cache/

# ---------- Certificate Storage ----------
storage/
public/storage/
uploads/
tmp/
temp/
